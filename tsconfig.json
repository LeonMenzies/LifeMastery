{
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": false,
    "types": ["jest"],
    "paths": {
      "~assets/*": [
        "./src/assets/*"
      ],
      "~components/*": [
        "./src/components/*"
      ],
      "~pages/*": [
        "./src/pages/*"
      ],
      "~store/*": [
        "./src/store/*"
      ],
      "~theme/*": [
        "./src/theme/*"
      ],
      "~types/*": [
        "./src/types/*"
      ],
      "~utils/*": [
        "./src/utils/*"
      ]
    }
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
